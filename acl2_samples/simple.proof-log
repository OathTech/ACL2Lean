(:DEFTHM MY-LEN-MY-APP :FORMULA 
(EQUAL (MY-LEN (MY-APP X Y)) (+ (MY-LEN X) (MY-LEN Y))) :SOURCE :LOCAL)

(:STEP :CLAUSE-ID "Goal" :PROCESSOR SETTLED-DOWN-CLAUSE :RESULT :SUBGOALS
:RUNES NIL :INPUT-CLAUSE 
((EQUAL (MY-LEN (MY-APP X Y)) (BINARY-+ (MY-LEN X) (MY-LEN Y)))) :NEW-
CLAUSES (((EQUAL (MY-LEN (MY-APP X Y)) (BINARY-+ (MY-LEN X) (MY-LEN Y))))))

(:STEP :CLAUSE-ID "Goal" :PROCESSOR PUSH-CLAUSE :RESULT :PROVED :RUNES
NIL :INPUT-CLAUSE 
((EQUAL (MY-LEN (MY-APP X Y)) (BINARY-+ (MY-LEN X) (MY-LEN Y)))) :REWRITES
((:BEGIN-LITERAL :ORIGIN CLAUSE/BEGIN-LITERAL
                 :INDEX 1
                 :LITERAL (EQUAL (MY-LEN (MY-APP X Y))
                                 (BINARY-+ (MY-LEN X) (MY-LEN Y)))
                 :NOT-FLG NIL)
 (:END-LITERAL :ORIGIN CLAUSE/END-LITERAL
               :INDEX 1
               :RESULT (EQUAL (MY-LEN (MY-APP X Y))
                              (BINARY-+ (MY-LEN X) (MY-LEN Y)))
               :BRANCHES 1)
 (:BEGIN-BRANCH :ORIGIN CLAUSE-LST/BEGIN-BRANCH
                :SEGMENT ((EQUAL (MY-LEN (MY-APP X Y))
                                 (BINARY-+ (MY-LEN X) (MY-LEN Y)))))
 (:END-BRANCH :ORIGIN CLAUSE-LST/END-BRANCH)))


(:INDUCTION :TERM (MY-APP X Y) :SUBGOAL-COUNT 2 :SCHEME 
(((CONSP X)
  (EQUAL (MY-LEN (MY-APP X Y))
         (BINARY-+ (MY-LEN X) (MY-LEN Y))))
 ((NOT (CONSP X))
  (NOT (EQUAL (MY-LEN (MY-APP (CDR X) Y))
              (BINARY-+ (MY-LEN (CDR X)) (MY-LEN Y))))
  (EQUAL (MY-LEN (MY-APP X Y))
         (BINARY-+ (MY-LEN X) (MY-LEN Y))))))


