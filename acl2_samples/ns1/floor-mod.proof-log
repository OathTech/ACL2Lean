(:STEP :CLAUSEID "Subgoal 1" :PROCESSOR SIMPLIFY-CLAUSE :RESULT :SUBGOALS :RUNES ((:DEFINITION ACL2-COUNT) (:DEFINITION SYNP) (:EXECUTABLE-COUNTERPART BINARY-+) (:EXECUTABLE-COUNTERPART UNARY--) (:FAKE-RUNE-FOR-TYPE-SET NIL) (:REWRITE |(+ 0 x)|) (:REWRITE |(+ x (- x))|) (:REWRITE |(+ y (+ x z))|) (:REWRITE |(+ y x)|) (:REWRITE |(< d (+ c x))|) (:REWRITE BUBBLE-DOWN-+-MATCH-1) (:REWRITE CAR-CONS) (:REWRITE CDR-CONS) (:REWRITE NORMALIZE-ADDENDS) (:REWRITE SIMPLIFY-SUMS-<) (:TYPE-PRESCRIPTION ACL2-COUNT)) :INPUTCLAUSE ((NOT (CONSP (CONS ARGS1 ARGS2))) (NOT (CONSP ARGS2)) (< (ACL2-COUNT ARGS2) (ACL2-COUNT (CONS ARGS1 ARGS2)))) :NEWCLAUSES (((NOT (CONSP ARGS2)) (< '-1 (ACL2-COUNT ARGS1)))) :REWRITES 
