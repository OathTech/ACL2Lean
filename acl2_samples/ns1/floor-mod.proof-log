 (:END-LITERAL :ORIGIN CLAUSE/END-LITERAL
               :EQUIV EQUAL :INDEX 3 :RESULT
               (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                   (EQUAL (BINARY-* X (UNARY-/ Y))
                          (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                 (IF (IF (EQUAL X '0)
                         'NIL
                       (IF (EQUAL Y '0)
                           'NIL
                         (IF (< X '0) (< '0 Y) (< Y '0))))
                     (IF (IF (< '0 X) (< '0 Y) 'NIL)
                         (EQUAL (NONNEGATIVE-INTEGER-QUOTIENT (NUMERATOR (BINARY-* X (UNARY-/ Y)))
                                                              (DENOMINATOR (BINARY-* X (UNARY-/ Y))))
                                (UNARY-- (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                       (DENOMINATOR (BINARY-* X (UNARY-/ Y))))))
                       (IF (IF (< X '0) (< Y '0) 'NIL)
                           (EQUAL (NONNEGATIVE-INTEGER-QUOTIENT (NUMERATOR (BINARY-* X (UNARY-/ Y)))
                                                                (DENOMINATOR (BINARY-* X (UNARY-/ Y))))
                                  (UNARY-- (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                         (DENOMINATOR (BINARY-* X (UNARY-/ Y))))))
                         'T))
                   (IF (IF (< '0 X) (< '0 Y) 'NIL)
                       'T
                     (IF (< X '0) (< Y '0) 'NIL))))
               :BRANCHES 14)
