                                        (IF (EQUAL D '1)
                                            N
                                          (IF (< N '0)
                                              (BINARY-+ (UNARY-- (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- N)
                                                                                               D))
                                                        '-1)
                                            (NONNEGATIVE-INTEGER-QUOTIENT N D))))
                                      (DENOMINATOR Q)
                                      (NUMERATOR Q)))
                                   (BINARY-* X (UNARY-/ Y)))
                                (IF (IF (< X '0) (< Y '0) 'NIL)
                                    ((LAMBDA (Q)
