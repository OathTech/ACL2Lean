                                                                                                 D))
                                                          '-1)
                                              (NONNEGATIVE-INTEGER-QUOTIENT N D))))
                                        (DENOMINATOR Q)
                                        (NUMERATOR Q)))
                                     (BINARY-* X (UNARY-/ Y)))
                                  (BINARY-+ '1
