                        (IF (NOT (< '0 J))
                            'T
                          (< (BINARY-* I (UNARY-/ J))
                             (BINARY-+ '1
                                       (NONNEGATIVE-INTEGER-QUOTIENT I J)))))))
                  :CLAUSE ((NOT (INTEGERP I))
                           (< I '0)
                           (NOT (INTEGERP J))
                           (NOT (< '0 J))
                           (< (BINARY-* I (UNARY-/ J))
                              (BINARY-+ '1
                                        (NONNEGATIVE-INTEGER-QUOTIENT I J)))))
 (:CLAUSIFY-OUT :ORIGIN CLAUSIFY/OUT
                :EQUIV EQUAL
