(:STEP :CLAUSEID "Goal" :PROCESSOR SIMPLIFY-CLAUSE :RESULT :PROVED :RUNES ((:DEFINITION FLOOR) (:DEFINITION MOD) (:DEFINITION REM) (:DEFINITION SYNP) (:EXECUTABLE-COUNTERPART BINARY-+) (:EXECUTABLE-COUNTERPART UNARY--) (:FAKE-RUNE-FOR-TYPE-SET NIL) (:REWRITE |(* (* x y) z)|) (:REWRITE |(* (+ x y) z)|) (:REWRITE |(* (- x) y)|) (:REWRITE |(* (if a b c) x)|) (:REWRITE |(* -1 x)|) (:REWRITE |(* 0 x)|) (:REWRITE |(* 1 x)|) (:REWRITE |(* a (/ a))|) (:REWRITE |(* x (if a b c))|) (:REWRITE |(* y x)|) (:REWRITE |(+ (+ x y) z)|) (:REWRITE |(+ (if a b c) x)|) (:REWRITE |(+ 0 x)|) (:REWRITE |(+ c (+ d x))|) (:REWRITE |(+ x (- x))|) (:REWRITE |(+ x (if a b c))|) (:REWRITE |(+ y x)|) (:REWRITE |(- (+ x y))|) (:REWRITE |(- (- x))|) (:REWRITE |(- (if a b c))|) (:REWRITE |(< (* x y) 0)|) (:REWRITE |(< (/ x) 0)|) (:REWRITE |(< 0 (/ x))|) (:REWRITE |(equal (/ x) 0)|) (:REWRITE BUBBLE-DOWN-+-MATCH-1) (:REWRITE BUBBLE-DOWN-+-MATCH-3) (:REWRITE NORMALIZE-ADDENDS) (:REWRITE NUMERATOR-NEGATIVE) (:REWRITE TRUNCATE-TO-FLOOR) (:TYPE-PRESCRIPTION NONNEGATIVE-INTEGER-QUOTIENT)) :INPUTCLAUSE ((NOT (RATIONALP X)) (NOT (RATIONALP Y)) (EQUAL (REM X Y) (IF (INTEGERP (BINARY-* X (UNARY-/ Y))) (IF (EQUAL Y '0) X '0) (IF (IF (< '0 X) (< '0 Y) 'NIL) (MOD X Y) (IF (IF (< X '0) (< Y '0) 'NIL) (MOD X Y) (BINARY-+ (MOD X Y) (UNARY-- Y))))))) :REWRITES 
((:CLAUSIFY-INPUT :ORIGIN
                  CLAUSIFY/INPUT :EQUIV EQUAL :TERM
                  (IF (NOT (RATIONALP X))
                      'T
                    (IF (NOT (RATIONALP Y))
                        'T
                      (EQUAL (REM X Y)
                             (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                                 (IF (EQUAL Y '0) X '0)
                               (IF (IF (< '0 X) (< '0 Y) 'NIL)
                                   (MOD X Y)
                                 (IF (IF (< X '0) (< Y '0) 'NIL)
                                     (MOD X Y)
                                   (BINARY-+ (MOD X Y) (UNARY-- Y)))))))))
 (:CLAUSIFY-NEG :ORIGIN CLAUSIFY/NEG
                :EQUIV EQUAL
                :CLAUSE ((NOT (IF (NOT (RATIONALP X))
                                  'T
                                (IF (NOT (RATIONALP Y))
                                    'T
                                  (EQUAL (REM X Y)
                                         (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                                             (IF (EQUAL Y '0) X '0)
                                           (IF (IF (< '0 X) (< '0 Y) 'NIL)
                                               (MOD X Y)
                                             (IF (IF (< X '0) (< Y '0) 'NIL)
                                                 (MOD X Y)
                                               (BINARY-+ (MOD X Y)
                                                         (UNARY-- Y)))))))))))
 (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND
                   :EQUIV EQUAL
                   :BOOL T
                   :FROM (NOT (RATIONALP X))
                   :TO (IF (RATIONALP X) 'NIL 'T)
                   :RUNES ((:DEFINITION NOT)))
 (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND
                   :EQUIV EQUAL
                   :BOOL T
                   :FROM (NOT (RATIONALP Y))
                   :TO (IF (RATIONALP Y) 'NIL 'T)
                   :RUNES NIL)
 (:CLAUSIFY-SPLIT :ORIGIN CLAUSIFY/SPLIT :EQUIV EQUAL :LIT
                  (IF (NOT (RATIONALP X))
                      'T
                    (IF (NOT (RATIONALP Y))
                        'T
                      (EQUAL (REM X Y)
                             (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                                 (IF (EQUAL Y '0) X '0)
                               (IF (IF (< '0 X) (< '0 Y) 'NIL)
                                   (MOD X Y)
                                 (IF (IF (< X '0) (< Y '0) 'NIL)
                                     (MOD X Y)
                                   (BINARY-+ (MOD X Y) (UNARY-- Y))))))))
                  :CLAUSE ((NOT (RATIONALP X))
                           (NOT (RATIONALP Y))
                           (EQUAL (REM X Y)
                                  (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                                      (IF (EQUAL Y '0) X '0)
                                    (IF (IF (< '0 X) (< '0 Y) 'NIL)
                                        (MOD X Y)
                                      (IF (IF (< X '0) (< Y '0) 'NIL)
                                          (MOD X Y)
                                        (BINARY-+ (MOD X Y) (UNARY-- Y))))))))
 (:CLAUSIFY-OUT :ORIGIN CLAUSIFY/OUT
                :EQUIV EQUAL
                :CLAUSES (((NOT (RATIONALP X))
                           (NOT (RATIONALP Y))
                           (EQUAL (REM X Y)
                                  (IF (INTEGERP (BINARY-* X (UNARY-/ Y)))
                                      (IF (EQUAL Y '0) X '0)
                                    (IF (IF (< '0 X) (< '0 Y) 'NIL)
                                        (MOD X Y)
                                      (IF (IF (< X '0) (< Y '0) 'NIL)
                                          (MOD X Y)
                                        (BINARY-+ (MOD X Y) (UNARY-- Y)))))))))
