((:CLAUSIFY-INPUT :ORIGIN
                  CLAUSIFY/INPUT :EQUIV EQUAL :TERM
                  (IF (NOT (INTEGERP I))
                      'T
                    (IF (< I '0)
                        'T
                      (IF (NOT (INTEGERP J))
                          'T
                        (IF (NOT (< '0 J))
                            'T
                          (< (BINARY-* I (UNARY-/ J))
                             (BINARY-+ '1
                                       (NONNEGATIVE-INTEGER-QUOTIENT I J))))))))
 (:CLAUSIFY-NEG :ORIGIN CLAUSIFY/NEG
                :EQUIV EQUAL
                :CLAUSE ((NOT (IF (NOT (INTEGERP I))
                                  'T
                                (IF (< I '0)
                                    'T
                                  (IF (NOT (INTEGERP J))
                                      'T
                                    (IF (NOT (< '0 J))
                                        'T
                                      (< (BINARY-* I (UNARY-/ J))
                                         (BINARY-+ '1
