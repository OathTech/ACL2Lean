 (:CLAUSIFY-LEAF :ORIGIN IF-INTERP/LEAF
                 :EQUIV EQUAL
                 :VALUE (INTEGERP (BINARY-+ '-1/2
                                            (BINARY-* '-1/2
                                                      (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                                    (DENOMINATOR (BINARY-* X (UNARY-/ Y)))))))
                 :OUTCOME SEGMENT-OPEN
                 :PATH ((:F INTEGERP (BINARY-* X (UNARY-/ Y)))
                        (:F EQUAL X '0)
                        (:F EQUAL Y '0)
                        (:T < X '0)
                        (:T < '0 Y)
                        (:F < '0
                            (BINARY-+ '1/2
                                      (BINARY-+ (BINARY-* X (UNARY-/ Y))
                                                (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                              (DENOMINATOR (BINARY-* X (UNARY-/ Y)))))))
                        (:F <
                            (BINARY-+ '1/2
                                      (BINARY-+ (BINARY-* X (UNARY-/ Y))
                                                (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                              (DENOMINATOR (BINARY-* X (UNARY-/ Y))))))
                            '0)
                        (:F INTEGERP
                            (BINARY-* '1/2
                                      (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                    (DENOMINATOR (BINARY-* X (UNARY-/ Y)))))))
                 :SEGMENT ((INTEGERP (BINARY-* X (UNARY-/ Y)))
                           (EQUAL X '0)
                           (EQUAL Y '0)
                           (NOT (< X '0))
                           (NOT (< '0 Y))
                           (< '0
                              (BINARY-+ '1/2
                                        (BINARY-+ (BINARY-* X (UNARY-/ Y))
                                                  (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                                (DENOMINATOR (BINARY-* X (UNARY-/ Y)))))))
                           (< (BINARY-+ '1/2
                                        (BINARY-+ (BINARY-* X (UNARY-/ Y))
                                                  (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                                (DENOMINATOR (BINARY-* X (UNARY-/ Y))))))
                              '0)
                           (INTEGERP (BINARY-* '1/2
                                               (NONNEGATIVE-INTEGER-QUOTIENT (UNARY-- (NUMERATOR (BINARY-* X (UNARY-/ Y))))
                                                                             (DENOMINATOR (BINARY-* X (UNARY-/ Y))))))
                           (INTEGERP (BINARY-+ '-1/2
                                               (BINARY-* '-1/2
