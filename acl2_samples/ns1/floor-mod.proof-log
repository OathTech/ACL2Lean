                   :RUNES ((:DEFINITION NOT)))
 (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND
                   :EQUIV EQUAL
                   :BOOL T
                   :FROM (NOT (INTEGERP J))
