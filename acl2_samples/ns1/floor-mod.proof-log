(:DEFTHM ROUND-TO-FLOOR :FORMULA (IMPLIES (AND (RATIONALP X) (RATIONALP Y)) (EQUAL (ROUND X Y) (COND ((< (MOD (* X (/ Y)) 1) 1/2) (FLOOR X Y)) ((< 1/2 (MOD (* X (/ Y)) 1)) (+ 1 (FLOOR X Y))) ((EVENP (FLOOR X Y)) (FLOOR X Y)) (T (+ 1 (FLOOR X Y)))))) :SOURCE :LOCAL :CLASSES (:REWRITE) :TFORMULA (IMPLIES (IF (RATIONALP X) (RATIONALP Y) 'NIL) (EQUAL (ROUND X Y) (IF (< (MOD (BINARY-* X (UNARY-/ Y)) '1) '1/2) (FLOOR X Y) (IF (< '1/2 (MOD (BINARY-* X (UNARY-/ Y)) '1)) (BINARY-+ '1 (FLOOR X Y)) (IF (EVENP (FLOOR X Y)) (FLOOR X Y) (BINARY-+ '1 (FLOOR X Y))))))))

