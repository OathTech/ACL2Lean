(:DEFTHM CONS-NEQ-DETAIL :FORMULA (IMPLIES (NOT (EQUAL A B)) (NOT (EQUAL (LIST* A B D) (LIST* B A D)))) :SOURCE :LOCAL :CLASSES (:REWRITE) :TFORMULA (IMPLIES (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))))))

(:STEP :CLAUSEID "Goal" :PROCESSOR PREPROCESS-CLAUSE :RESULT :PROVED :RUNES ((:DEFINITION NOT) (:REWRITE CONS-EQUAL)) :INPUTCLAUSE ((IMPLIES (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))))) :REWRITES ((:REWRITE-STEP :RUNE (:DEFINITION IMPLIES) :ORIGIN FINAL-IMPLIES/EXPAND :EQUIV EQUAL :LHS (IMPLIES (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))))) :RHS (IF (NOT (EQUAL A B)) (IF (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) 'T 'NIL) 'T)) (:REWRITE-STEP :RUNE (:IF-SIMPLIFICATION NIL) :ORIGIN PREPROCESS/IF-IFF :EQUIV IFF :LHS (IF (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) 'T 'NIL) :RHS (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))))) (:CLAUSIFY-INPUT :ORIGIN CLAUSIFY/INPUT :EQUIV EQUAL :TERM (IF (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) 'T)) (:CLAUSIFY-NEG :ORIGIN CLAUSIFY/NEG :EQUIV EQUAL :CLAUSE ((NOT (IF (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) 'T)))) (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND :EQUIV EQUAL :BOOL NIL :FROM (NOT (EQUAL A B)) :TO (IF (EQUAL A B) 'NIL 'T) :RUNES ((:DEFINITION NOT))) (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND :EQUIV EQUAL :BOOL T :FROM (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) :TO (IF (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))) 'NIL 'T) :RUNES NIL) (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND :EQUIV EQUAL :BOOL NIL :FROM (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))) :TO (IF (EQUAL A B) (EQUAL (CONS B D) (CONS A D)) 'NIL) :RUNES ((:REWRITE CONS-EQUAL))) (:REWRITE-STEP :RUNE (:EQUAL-SELF NIL) :ORIGIN PREPROCESS/EQUAL-SELF :EQUIV EQUAL :LHS (EQUAL D D) :RHS 'T) (:REWRITE-STEP :RUNE (:IF-SIMPLIFICATION NIL) :ORIGIN PREPROCESS/IF-IFF :EQUIV IFF :LHS (IF (EQUAL B A) 'T 'NIL) :RHS (EQUAL B A)) (:CLAUSIFY-EXPAND :ORIGIN CLAUSIFY/EXPAND :EQUIV EQUAL :BOOL NIL :FROM (EQUAL (CONS B D) (CONS A D)) :TO (EQUAL B A) :RUNES NIL) (:DEDUP-DROP :ORIGIN DEDUP-DROP :LIT (NOT (EQUAL B A))) (:COMPLEMENT-CLOSE :ORIGIN COMPLEMENT-CLOSE :LIT (NOT (EQUAL A B))) (:CLAUSIFY-SPLIT :ORIGIN CLAUSIFY/SPLIT :EQUIV EQUAL :LIT (IF (NOT (EQUAL A B)) (NOT (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D)))) 'T) :CLAUSE ('T)) (:CLAUSIFY-OUT :ORIGIN CLAUSIFY/OUT :EQUIV EQUAL :CLAUSES NIL)))

(:QED)

(:RULES (((:REWRITE CONS-NEQ-DETAIL) ((NOT (EQUAL A B))) EQUAL (EQUAL (CONS A (CONS B D)) (CONS B (CONS A D))) 'NIL NIL)))

(:DEFUN IMPLIES :FORMALS (P Q) :BODY (IF P (IF Q 'T 'NIL) 'T) :SOURCE :GROUND-ZERO)

(:TYPE-PRESCRIPTION IMPLIES :COROLLARY (IF (EQUAL (IMPLIES P Q) 'T) 'T (EQUAL (IMPLIES P Q) 'NIL)) :BASICTS 384 :LEAVES (('T 256 (P Q) ((Q -129) (P -129)) NIL) ('NIL 128 (P (NOT Q)) ((Q 128) (P -129)) NIL) ('T 256 ((NOT P)) ((P 128)) NIL)) :ALL-TPS (((:TYPE-PRESCRIPTION IMPLIES) NIL 384 (IF (EQUAL (IMPLIES P Q) 'T) 'T (EQUAL (IMPLIES P Q) 'NIL)) (IMPLIES P Q) (('T 256 (P Q) ((Q -129) (P -129)) NIL) ('NIL 128 (P (NOT Q)) ((Q 128) (P -129)) NIL) ('T 256 ((NOT P)) ((P 128)) NIL)))))

(:DEFUN NOT :FORMALS (P) :BODY (IF P 'NIL 'T) :SOURCE :GROUND-ZERO)

(:TYPE-PRESCRIPTION NOT :COROLLARY (IF (EQUAL (NOT P) 'T) 'T (EQUAL (NOT P) 'NIL)) :BASICTS 384 :LEAVES (('NIL 128 (P) ((P -129)) NIL) ('T 256 ((NOT P)) ((P 128)) NIL)) :ALL-TPS (((:TYPE-PRESCRIPTION NOT) NIL 384 (IF (EQUAL (NOT P) 'T) 'T (EQUAL (NOT P) 'NIL)) (NOT P) (('NIL 128 (P) ((P -129)) NIL) ('T 256 ((NOT P)) ((P 128)) NIL)))))

(:DEFUN IFF :FORMALS (P Q) :BODY (IF P (IF Q 'T 'NIL) (IF Q 'NIL 'T)) :SOURCE :GROUND-ZERO)

(:TYPE-PRESCRIPTION IFF :COROLLARY (IF (EQUAL (IFF P Q) 'T) 'T (EQUAL (IFF P Q) 'NIL)) :BASICTS 384 :LEAVES (('T 256 (P Q) ((Q -129) (P -129)) NIL) ('NIL 128 (P (NOT Q)) ((Q 128) (P -129)) NIL) ('NIL 128 ((NOT P) Q) ((Q -129) (P 128)) NIL) ('T 256 ((NOT P) (NOT Q)) ((Q 128) (P 128)) NIL)) :ALL-TPS (((:TYPE-PRESCRIPTION IFF) NIL 384 (IF (EQUAL (IFF P Q) 'T) 'T (EQUAL (IFF P Q) 'NIL)) (IFF P Q) (('T 256 (P Q) ((Q -129) (P -129)) NIL) ('NIL 128 (P (NOT Q)) ((Q 128) (P -129)) NIL) ('NIL 128 ((NOT P) Q) ((Q -129) (P 128)) NIL) ('T 256 ((NOT P) (NOT Q)) ((Q 128) (P 128)) NIL)))))

(:GROUND-ZERO-RULES (((:REWRITE CONS-EQUAL) NIL EQUAL (EQUAL (CONS X1 Y1) (CONS X2 Y2)) (IF (EQUAL X1 X2) (EQUAL Y1 Y2) 'NIL) NIL)))

(:CONS-TERM-GUARDS ((ACL2-NUMBERP (X) 'T) (BINARY-* (X Y) (IF (ACL2-NUMBERP X) (ACL2-NUMBERP Y) 'NIL)) (BINARY-+ (X Y) (IF (ACL2-NUMBERP X) (ACL2-NUMBERP Y) 'NIL)) (UNARY-- (X) (ACL2-NUMBERP X)) (UNARY-/ (X) (IF (ACL2-NUMBERP X) (NOT (EQUAL X '0)) 'NIL)) (< (X Y) (IF (RATIONALP X) (RATIONALP Y) 'NIL)) (CAR (X) (IF (CONSP X) 'T (EQUAL X 'NIL))) (CDR (X) (IF (CONSP X) 'T (EQUAL X 'NIL))) (CHAR-CODE (X) (CHARACTERP X)) (CHARACTERP (X) 'T) (CODE-CHAR (X) (IF (INTEGERP X) (IF (< X '0) 'NIL (< X '256)) 'NIL)) (COMPLEX (X Y) (IF (RATIONALP X) (RATIONALP Y) 'NIL)) (COMPLEX-RATIONALP (X) 'T) (COERCE (X Y) (IF (EQUAL Y 'LIST) (STRINGP X) (IF (EQUAL Y 'STRING) (CHARACTER-LISTP X) 'NIL))) (CONS (X Y) 'T) (CONSP (X) 'T) (DENOMINATOR (X) (RATIONALP X)) (EQUAL (X Y) 'T) (IMAGPART (X) (ACL2-NUMBERP X)) (INTEGERP (X) 'T) (INTERN-IN-PACKAGE-OF-SYMBOL (STR SYM) (IF (STRINGP STR) (SYMBOLP SYM) 'NIL)) (NUMERATOR (X) (RATIONALP X)) (RATIONALP (X) 'T) (REALPART (X) (ACL2-NUMBERP X)) (STRINGP (X) 'T) (SYMBOL-NAME (X) (SYMBOLP X)) (SYMBOL-PACKAGE-NAME (X) (SYMBOLP X)) (SYMBOLP (X) 'T)))

(:CAPTURE-END :BOOKS NIL :STATUS :COMPLETE)
